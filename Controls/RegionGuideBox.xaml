<UserControl x:Class="PokemonHelper.Controls.RegionGuideBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True"
             Cursor="SizeAll"
             Background="Transparent"
             MinWidth="20" MinHeight="20">
    <Grid x:Name="RootGrid">
        <Border x:Name="BodyBorder" BorderBrush="Red" BorderThickness="2" Background="Transparent" />
        <Border x:Name="LabelBorder" Background="#88000000" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="2,1">
            <TextBlock x:Name="LabelText" Text="Region" Foreground="White" FontWeight="Normal" FontSize="10" />
        </Border>
        
        <!-- 코너 크기 조절 핸들 -->
        <Ellipse x:Name="HandleNW" Width="10" Height="10" Fill="White" Stroke="Red" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" Cursor="SizeNWSE" />
        <Ellipse x:Name="HandleNE" Width="10" Height="10" Fill="White" Stroke="Red" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Cursor="SizeNESW" />
        <Ellipse x:Name="HandleSW" Width="10" Height="10" Fill="White" Stroke="Red" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" Cursor="SizeNESW" />
        <Ellipse x:Name="HandleSE" Width="10" Height="10" Fill="White" Stroke="Red" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" Cursor="SizeNWSE" />
    </Grid>
</UserControl>
